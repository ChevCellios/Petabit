<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Data\starlink-bootstrap.json.gz" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Remove="App_Data\**\*" />
		<None Remove="App_Data\**\*" />
		<Content Update="wwwroot\lib\**\*.map" CopyToPublishDirectory="Never" />
		<Content Update="wwwroot\lib\bootstrap\dist\css\*.css" CopyToPublishDirectory="Never" />
		<Content Update="wwwroot\lib\bootstrap\dist\css\bootstrap.min.css" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="wwwroot\lib\bootstrap\dist\js\**\*" CopyToPublishDirectory="Never" />
	</ItemGroup>

</Project>
