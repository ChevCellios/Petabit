@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="content-page privacy-page">
<h1>@Localizer["Title"]</h1>

<p>@Localizer["WelcomeText"]</p>

<p>@Localizer["IntroText"]</p>

<h2>@Localizer["DataCollected"]</h2>
<ul>
    <li><strong>@Localizer["DataPoint1"]</strong></li>
    <li>@Localizer["DataPoint2"]</li>
</ul>

<h2>@Localizer["Cookies"]</h2>
<ul>
    <li>@Localizer["CookiesPoint1"]</li>
    <li>@Localizer["CookiesPoint2"]</li>
</ul>

<h2>@Localizer["CookiePolicy"]</h2>
<p>@Localizer["CookiePolicyIntro"]</p>

<h3>@Localizer["NecessaryTechnologies"]</h3>
<div class="table-responsive">
<table class="table">
    <thead>
        <tr><th>@Localizer["Name"]</th><th>@Localizer["Purpose"]</th><th>@Localizer["Duration"]</th></tr>
    </thead>
    <tbody>
        <tr><td>.AspNetCore.Culture</td><td>@Localizer["CulturePurpose"]</td><td>@Localizer["OneYear"]</td></tr>
        <tr><td>petabit-analytics-consent</td><td>@Localizer["ConsentPurpose"]</td><td>@Localizer["ConsentDuration"]</td></tr>
    </tbody>
</table>
</div>

<h3>@Localizer["AnalyticsCookies"]</h3>
<p>@Localizer["AnalyticsDescription"]</p>
<div class="table-responsive">
<table class="table">
    <thead>
        <tr><th>@Localizer["Name"]</th><th>@Localizer["Purpose"]</th><th>@Localizer["Duration"]</th></tr>
    </thead>
    <tbody>
        <tr><td>_ga</td><td>@Localizer["GaPurpose"]</td><td>@Localizer["UpToTwoYears"]</td></tr>
        <tr><td>_ga_W5Z2EDHVY4</td><td>@Localizer["GaSessionPurpose"]</td><td>@Localizer["UpToTwoYears"]</td></tr>
    </tbody>
</table>
</div>
<p>@Localizer["GaMoreInfo"] <a href="https://support.google.com/analytics/answer/11397207" target="_blank" rel="noopener noreferrer">@Localizer["GaDocumentation"]</a>.</p>

<h3>@Localizer["ConsentManagement"]</h3>
<p>@Localizer["ConsentManagementText"]</p>
<button id="manage-analytics-consent" type="button" class="btn btn-outline-primary">@Localizer["ManageConsent"]</button>

<h2>@Localizer["DataSecurity"]</h2>
<p>@Localizer["DataSecurityText"]</p>

<h2>@Localizer["YourRights"]</h2>
<p>@Localizer["YourRightsText"]</p>

<h2>@Localizer["PolicyChanges"]</h2>
<p>@Localizer["PolicyChangesText"]</p>

<p>@Localizer["ThankYou"]</p>

<h2>@Localizer["Contact"]</h2>
<p>@Localizer["ContactText"] <a href="https://github.com/ChevCellios/Petabit/issues">GitHub Issues</a>.</p>
</div>


