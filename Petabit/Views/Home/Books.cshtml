@{
    ViewData["Title"] = "Preporučene knjige za programiranje";
    ViewData["Description"] = "Izbor knjiga za programiranje, razvoj softvera i profesionalni tehnološki rast.";
}

@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container mt-5">
    <h1>📚 @Localizer["LearnWithBooks"]</h1>
    <ul class="list-group mt-3">
        <li class="list-group-item">
            <a href="https://www.informit.com/store/clean-code-a-handbook-of-agile-software-craftsmanship-9780132350884" target="_blank" rel="noopener noreferrer">@Localizer["Clean Code – Robert C. Martin"]</a>
        </li>
        <li class="list-group-item">
            <a href="https://store.pragprog.com/titles/tpp20/the-pragmatic-programmer-20th-anniversary-edition/" target="_blank" rel="noopener noreferrer">@Localizer["The Pragmatic Programmer"]</a>
        </li>
        <!-- More books to come -->
    </ul>
</div>

