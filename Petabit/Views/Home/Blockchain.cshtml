@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["BlockchainTechnology"];
    ViewData["Description"] = "Uvod u blockchain tehnologiju i korisni resursi za daljnje istraživanje decentraliziranih sustava.";
}

<div class="container content-page resource-page">
    <a class="resource-back" href="/">@Localizer["BackHome"]</a>
    <p class="resource-kicker">@Localizer["ExploreResources"]</p>
    <h1 class="display-4">🪙 @Localizer["BlockchainTechnology"]</h1>
    <p class="resource-intro">@Localizer["PageIntro"]</p>

    <div class="mt-4">
        <p class="lead">
            @Localizer["BlockchainTechnologyDescription"]
        </p>

        <a href="https://minepi.com/SuperBolt" target="_blank" rel="noopener noreferrer" class="btn btn-outline-warning mt-3">
            🌐 @Localizer["VisitPiNetwork"]
        </a>
    </div>
</div>
