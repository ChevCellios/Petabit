@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using System.Globalization

@{
    // Postavlja naslov stranice koji će se prikazati u pregledniku
    ViewData["Title"] = "Petabit – ISS i Starlink Tracker";
    ViewData["Description"] = "Istraži Petabit: višejezičnu platformu za učenje, tehnološke preporuke, blockchain sadržaj i praćenje Međunarodne svemirske postaje uživo.";
    var cspNonce = Context.Items["CspNonce"]?.ToString();
}

<div class="container home-hero">
    <!-- Glavni naslov aplikacije -->
    <h1 class="display-4">Petabit 🌍</h1>
    <!-- Lokalizirani tekst dobrodošlice -->
    <p class="lead">@Localizer["WelcomeText"]</p>

    <div id="iss-led-localization" hidden
         data-locale="@CultureInfo.CurrentUICulture.Name"
         data-loading="@Localizer["Loading"]"
         data-checked="@Localizer["Checked"]"
         data-position-updated="@Localizer["PositionUpdated"]"
         data-stale="@Localizer["Stale"]"
         data-review="@Localizer["Review"]"
         data-persistence="@Localizer["PersistenceWarning"]"
         data-no-events="@Localizer["NoEvents"]"
         data-news="@Localizer["EventNews"]"
         data-arrival="@Localizer["EventArrival"]"
         data-departure="@Localizer["EventDeparture"]"
         data-crew-arrival="@Localizer["EventCrewArrival"]"
         data-refresh="@Localizer["Refresh"]"
         data-confirmed="@Localizer["Confirmed"]"
         data-video-loading="@Localizer["VideoLoading"]"
         data-video-playing="@Localizer["VideoPlaying"]"
         data-video-ended="@Localizer["VideoEnded"]"
         data-video-error="@Localizer["VideoError"]"
         data-video-blocked="@Localizer["VideoBlocked"]"
         data-video-title="@Localizer["VideoTitle"]"
         data-location="@Localizer["LedLocation"]"
         data-latitude="@Localizer["LedLatitude"]"
         data-longitude="@Localizer["LedLongitude"]"
         data-speed="@Localizer["LedSpeed"]"
         data-astronauts="@Localizer["LedAstronauts"]"
         data-crew="@Localizer["LedCrew"]"
         data-docked="@Localizer["LedDocked"]"
         data-reference="@Localizer["LedReference"]"
         data-source="@Localizer["LedSource"]"
         data-unavailable="@Localizer["LedUnavailable"]"
         data-country-usa="@Localizer["CountryUsa"]"
         data-country-canada="@Localizer["CountryCanada"]"
         data-country-france="@Localizer["CountryFrance"]"
         data-country-russia="@Localizer["CountryRussia"]"
         data-purpose-crewed="@Localizer["PurposeCrewed"]"
         data-purpose-cargo="@Localizer["PurposeCargo"]"></div>

    <div class="mt-4">
        <!-- Gumbi u jednom redu, svaki u svojoj koloni -->
        <div class="row justify-content-center mb-4 home-destinations">
            <div class="col-auto">
                <a href="/Home/Books" class="btn btn-home"><span>📚 @Localizer["BooksLink"]</span><small>@Localizer["BooksSummary"]</small><span class="destination-arrow" aria-hidden="true">↗</span></a>
            </div>
            <div class="col-auto">
                <a href="/Home/Apps" class="btn btn-home"><span>📱 @Localizer["AppsLink"]</span><small>@Localizer["AppsSummary"]</small><span class="destination-arrow" aria-hidden="true">↗</span></a>
            </div>
            <div class="col-auto">
                <a href="/Home/Blockchain" class="btn btn-home"><span>🪙 @Localizer["BlockchainLink"]</span><small>@Localizer["BlockchainSummary"]</small><span class="destination-arrow" aria-hidden="true">↗</span></a>
            </div>
        </div>

        <!-- Sekcija za ISS Tracker -->
        <h2 class="text-center mt-4">🌐 @Localizer["TrackerTitle"]</h2><p class="tracker-intro">@Localizer["TrackerIntro"]</p>

        <!-- Gumb za dohvat trenutnih podataka o ISS-u -->
        <div class="tracker-actions"><button id="iss-ping-button" aria-controls="iss-panel" aria-expanded="false" class="btn tracker-ping">@Localizer["Refresh"]</button> <label class="iss-sound-option"><input id="iss-sound-enabled" type="checkbox" /> @Localizer["Sound"]</label>
        <button id="starlink-ping-button" aria-controls="starlink-panel" aria-expanded="false" class="btn tracker-ping starlink-ping-button">🛰 Ping Starlink</button></div>
        <!-- Zvuk koji se reproducira prilikom pritiska na gumb -->
        <audio id="ping-sound" src="/sounds/zvuk.mp3" preload="auto"></audio>

        <div id="iss-led-display" class="iss-led-display" aria-hidden="true" hidden>
            <span id="iss-led-message" class="iss-led-message"></span>
        </div>
        <section id="iss-video-panel" class="station-panel iss-video-panel" aria-labelledby="iss-video-title" hidden>
            <div class="tracker-panel-heading"><h3 id="iss-video-title">@Localizer["VideoTitle"]</h3><button type="button" id="iss-video-close" class="tracker-close" aria-label="@Localizer["ClosePanel"]">×</button></div>
            <p class="panel-reference">@Localizer["VideoNote"]</p>
            <div id="iss-video-stage" class="iss-video-stage"></div>
            <p id="iss-video-status" class="iss-video-status" role="status" aria-live="polite"></p>
            <a href="https://eol.jsc.nasa.gov/ESRS/HDEV/" target="_blank" rel="noopener noreferrer">@Localizer["VideoSource"]</a>
        </section>

        <!-- Ovdje će se prikazati rezultati dohvaćenih podataka o ISS-u -->
        <section id="starlink-panel" class="station-panel starlink-panel" aria-labelledby="starlink-title" hidden
                 data-locale="@CultureInfo.CurrentUICulture.Name"
                 data-loading="@Localizer["StarlinkLoading"]" data-error="@Localizer["StarlinkError"]"
                 data-stale="@Localizer["StarlinkStale"]" data-mapped="@Localizer["StarlinkCoverage"]"
                 data-motion="@Localizer["StarlinkMotion"]" data-paused="@Localizer["StarlinkPaused"]"
                 data-updated="@Localizer["StarlinkUpdated"]" data-epoch="@Localizer["StarlinkEpoch"]" data-simulation="@Localizer["StarlinkSimulation"]" data-realtime="@Localizer["StarlinkRealtime"]" data-legacy="@Localizer["StarlinkLegacy"]">
            <div class="starlink-heading"><div><p class="iss-hologram-kicker">STARLINK · ORBITAL NETWORK</p><h3 id="starlink-title">@Localizer["StarlinkTitle"]</h3></div>
                <button type="button" id="starlink-close" class="tracker-close" aria-label="@Localizer["ClosePanel"]">×</button></div><div class="starlink-controls"><label class="starlink-motion"><input id="starlink-motion" type="checkbox" checked /> @Localizer["StarlinkAnimate"]</label><label class="starlink-speed">@Localizer["StarlinkSpeed"] <select id="starlink-speed"><option value="1">@Localizer["StarlinkRealtime"]</option><option value="30" selected>@Localizer["StarlinkSimulation"]</option></select></label></div>
            <div class="starlink-metrics">
                <div><strong id="starlink-operational">—</strong><span>@Localizer["StarlinkOperational"]</span></div>
                <div><strong id="starlink-orbit">—</strong><span>@Localizer["StarlinkOnOrbit"]</span></div>
                <div><strong id="starlink-nonoperational">—</strong><span>@Localizer["StarlinkNonOperational"]</span></div><div><strong id="starlink-partial">—</strong><span>@Localizer["StarlinkPartial"]</span></div>
            </div>
            <p id="starlink-status" class="panel-reference" role="status" aria-live="polite"></p>
            <p id="starlink-warning" class="station-warning" role="status" hidden></p>
            <div class="starlink-legend"><span class="status-operational">● @Localizer["StarlinkOperational"]</span><span class="status-partial">● @Localizer["StarlinkPartial"]</span><span class="status-nonoperational">● @Localizer["StarlinkNonOperational"]</span><span class="status-other">● @Localizer["StarlinkOther"]</span></div><div class="starlink-stage"><canvas id="starlink-globe" aria-label="@Localizer["StarlinkCanvas"]"></canvas></div>
            <p class="starlink-note">@Localizer["StarlinkNote"]</p>
            <p id="starlink-coverage" class="panel-reference"></p><p id="starlink-freshness" class="panel-reference"></p>
            <a href="https://celestrak.org/satcat/status.php" target="_blank" rel="noopener noreferrer">CelesTrak · @Localizer["StarlinkSource"]</a>
        </section>
        <section id="iss-panel" class="tracker-panel" aria-labelledby="iss-panel-title" hidden>
            <div class="tracker-panel-heading"><h3 id="iss-panel-title">ISS Tracker</h3><button type="button" id="iss-close" class="tracker-close" aria-label="@Localizer["ClosePanel"]">×</button></div>
        <section class="iss-hologram" aria-labelledby="iss-hologram-title">
            <div class="iss-hologram-heading">
                <div>
                    <p class="iss-hologram-kicker">@Localizer["HologramKicker"]</p>
                    <h3 id="iss-hologram-title">@Localizer["HologramTitle"]</h3>
                </div>
                <span id="iss-hologram-status" class="iss-hologram-status">@Localizer["HologramWaiting"]</span>
            </div>
            <div class="iss-hologram-stage">
                <canvas id="iss-globe-canvas" aria-label="@Localizer["HologramCanvasLabel"]"></canvas>
                <div class="iss-scanline" aria-hidden="true"></div>
            </div>
            <p class="iss-hologram-note">@Localizer["HologramNote"]</p>
        </section>

        <div id="iss-result" class="mt-3" role="status" aria-live="polite"></div>
        <div id="station-dashboard" class="station-dashboard">
            <div class="iss-metrics">
                <div class="iss-metric"><span>@Localizer["LedLocation"]</span><strong id="metric-position">—</strong><small id="position-freshness">@Localizer["Loading"]</small></div>
                <div class="iss-metric"><span>@Localizer["LedSpeed"]</span><strong id="metric-speed">—</strong><small>km/h</small></div>
                <div class="iss-metric"><span>@Localizer["LedCrew"]</span><strong id="metric-crew">—</strong><small>@Localizer["OnStation"]</small></div>
                <div class="iss-metric"><span>@Localizer["VehiclesTitle"]</span><strong id="metric-vehicles">—</strong><small>@Localizer["DockedStatus"]</small></div>
            </div>
            <p id="station-freshness" class="station-freshness" role="status">@Localizer["Loading"]</p>
            <p id="station-warning" class="station-warning" role="status" hidden></p>
            <div class="station-columns">
                <section class="station-panel" aria-labelledby="crew-title"><h3 id="crew-title">@Localizer["LedCrew"]</h3><p id="crew-reference" class="panel-reference"></p><ul id="station-crew" class="station-list"></ul></section>
                <section class="station-panel" aria-labelledby="vehicles-title"><h3 id="vehicles-title">@Localizer["VehiclesTitle"]</h3><p id="vehicles-reference" class="panel-reference"></p><ul id="station-vehicles" class="station-list"></ul></section>
            </div>
            <section class="station-panel station-events" aria-labelledby="events-title"><h3 id="events-title">@Localizer["EventsTitle"]</h3><p class="panel-reference">@Localizer["EventsNote"]</p><ol id="station-events" class="station-list"></ol></section>
        </div>
        </section>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/iss-hologram.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/station-dashboard.js" asp-append-version="true"></script>
    <script src="~/js/iss-video-preview.js" asp-append-version="true"></script>
    <script type="module" src="~/js/starlink-dashboard.js" asp-append-version="true"></script>
    <script nonce="@cspNonce">
        const globeCanvas = document.getElementById('iss-globe-canvas');
        const globeContext = globeCanvas.getContext('2d');
        const globeHologram = document.querySelector('.iss-hologram');
        const globeStatus = document.getElementById('iss-hologram-status');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let issPosition = null;
        let globeAnimationFrame;

        const continentOutlines = [
            [[72,-168],[70,-140],[60,-128],[55,-122],[49,-125],[43,-124],[34,-117],[23,-110],[17,-96],[25,-82],[30,-81],[43,-70],[51,-58],[59,-64],[66,-80],[73,-105],[72,-135],[72,-168]],
            [[12,-81],[8,-77],[-5,-81],[-18,-70],[-35,-72],[-55,-68],[-52,-55],[-34,-52],[-20,-40],[-5,-35],[7,-51],[12,-66],[12,-81]],
            [[71,-10],[65,5],[58,10],[51,3],[44,-9],[36,-6],[35,10],[43,18],[39,29],[47,40],[55,58],[60,80],[72,105],[70,140],[61,163],[50,143],[43,132],[35,126],[22,114],[10,105],[7,80],[21,72],[30,50],[38,36],[45,28],[55,22],[62,14],[71,-10]],
            [[36,-17],[37,10],[31,32],[15,43],[2,51],[-12,44],[-25,35],[-35,18],[-30,8],[-17,12],[-5,8],[5,-1],[15,-17],[28,-13],[36,-17]],
            [[-11,113],[-18,122],[-25,113],[-35,117],[-39,146],[-29,154],[-17,146],[-11,132],[-11,113]],
            [[83,-52],[77,-72],[68,-54],[60,-44],[64,-25],[76,-18],[83,-52]],
            [[-66,-180],[-70,-135],[-68,-90],[-73,-45],[-70,0],[-74,45],[-69,90],[-72,135],[-66,180]]
        ];

        function resizeGlobeCanvas() {
            const stage = globeCanvas.parentElement;
            const ratio = Math.min(window.devicePixelRatio || 1, 2);
            const width = stage.clientWidth;
            const height = stage.clientHeight;
            globeCanvas.width = Math.round(width * ratio);
            globeCanvas.height = Math.round(height * ratio);
            globeContext.setTransform(ratio, 0, 0, ratio, 0, 0);
        }

        function projectGlobePoint(latitude, longitude, rotation, radius, centerX, centerY) {
            const lat = latitude * Math.PI / 180;
            const lon = longitude * Math.PI / 180 + rotation;
            const depth = Math.cos(lat) * Math.cos(lon);
            return {
                x: centerX + radius * Math.cos(lat) * Math.sin(lon),
                y: centerY - radius * Math.sin(lat),
                visible: depth >= 0,
                depth
            };
        }

        function drawProjectedLine(points, color, width, glow = 0) {
            globeContext.strokeStyle = color;
            globeContext.lineWidth = width;
            globeContext.shadowColor = color;
            globeContext.shadowBlur = glow;
            globeContext.beginPath();
            let drawing = false;
            points.forEach(point => {
                if (!point.visible) {
                    drawing = false;
                    return;
                }
                if (!drawing) globeContext.moveTo(point.x, point.y);
                else globeContext.lineTo(point.x, point.y);
                drawing = true;
            });
            globeContext.stroke();
            globeContext.shadowBlur = 0;
        }

        function drawGlobe(time = 0) {
            const width = globeCanvas.clientWidth;
            const height = globeCanvas.clientHeight;
            const centerX = width / 2;
            const centerY = height / 2;
            const radius = Math.min(width, height) * 0.36;
            const isLight = document.body.classList.contains('light-mode');
            const grid = isLight ? 'rgba(0, 105, 105, 0.32)' : 'rgba(72, 255, 218, 0.32)';
            const bright = isLight ? '#007b78' : '#62ffe1';
            const dim = isLight ? 'rgba(0, 100, 110, 0.45)' : 'rgba(75, 255, 220, 0.11)';
            const baseRotation = issPosition ? -issPosition.longitude * Math.PI / 180 : 0;
            const rotation = reduceMotion.matches
                ? baseRotation
                : baseRotation + (issPosition ? Math.sin(time * 0.00012) * 0.32 : time * 0.00006);

            globeContext.clearRect(0, 0, width, height);
            const aura = globeContext.createRadialGradient(centerX, centerY, radius * 0.25, centerX, centerY, radius * 1.25);
            aura.addColorStop(0, dim);
            aura.addColorStop(0.72, 'rgba(0, 0, 0, 0)');
            globeContext.fillStyle = aura;
            globeContext.fillRect(0, 0, width, height);

            globeContext.strokeStyle = bright;
            globeContext.lineWidth = 1.2;
            globeContext.shadowColor = bright;
            globeContext.shadowBlur = 14;
            globeContext.beginPath();
            globeContext.arc(centerX, centerY, radius, 0, Math.PI * 2);
            globeContext.stroke();
            globeContext.shadowBlur = 0;

            continentOutlines.forEach(continent => {
                const outline = continent.map(([latitude, longitude]) =>
                    projectGlobePoint(latitude, longitude, rotation, radius * 0.995, centerX, centerY));
                drawProjectedLine(outline, isLight ? 'rgba(0, 92, 84, 0.58)' : 'rgba(116, 255, 226, 0.62)', 1.15, 3);
            });

            for (let latitude = -60; latitude <= 60; latitude += 30) {
                const points = [];
                for (let longitude = -180; longitude <= 180; longitude += 4) {
                    points.push(projectGlobePoint(latitude, longitude, rotation, radius, centerX, centerY));
                }
                drawProjectedLine(points, grid, 0.7);
            }

            for (let longitude = -150; longitude <= 180; longitude += 30) {
                const points = [];
                for (let latitude = -90; latitude <= 90; latitude += 3) {
                    points.push(projectGlobePoint(latitude, longitude, rotation, radius, centerX, centerY));
                }
                drawProjectedLine(points, grid, 0.7);
            }

            if (issPosition) {
                const inclination = 51.6;
                const phase = Math.asin(Math.max(-1, Math.min(1, issPosition.latitude / inclination)));
                const groundTrackDegreesPerOrbit = 336;
                const orbit = [];
                const orbitalCoordinate = angle => ({
                    latitude: inclination * Math.sin(angle),
                    longitude: issPosition.longitude
                        + (angle - phase) * groundTrackDegreesPerOrbit / (Math.PI * 2)
                });

                for (let offsetDegrees = -180; offsetDegrees <= 180; offsetDegrees += 2) {
                    const angle = phase + offsetDegrees * Math.PI / 180;
                    const coordinate = orbitalCoordinate(angle);
                    orbit.push(projectGlobePoint(coordinate.latitude, coordinate.longitude, rotation, radius * 1.08, centerX, centerY));
                }
                drawProjectedLine(orbit, bright, 1.5, 7);

                const arrowStartCoordinate = orbitalCoordinate(phase + 0.10);
                const arrowTipCoordinate = orbitalCoordinate(phase + 0.18);
                const arrowStart = projectGlobePoint(arrowStartCoordinate.latitude, arrowStartCoordinate.longitude, rotation, radius * 1.08, centerX, centerY);
                const arrowTip = projectGlobePoint(arrowTipCoordinate.latitude, arrowTipCoordinate.longitude, rotation, radius * 1.08, centerX, centerY);

                if (arrowStart.visible && arrowTip.visible) {
                    const arrowAngle = Math.atan2(arrowTip.y - arrowStart.y, arrowTip.x - arrowStart.x);
                    const arrowSize = 9;
                    globeContext.fillStyle = bright;
                    globeContext.shadowColor = bright;
                    globeContext.shadowBlur = 9;
                    globeContext.beginPath();
                    globeContext.moveTo(arrowTip.x + Math.cos(arrowAngle) * arrowSize, arrowTip.y + Math.sin(arrowAngle) * arrowSize);
                    globeContext.lineTo(arrowTip.x + Math.cos(arrowAngle + 2.45) * arrowSize, arrowTip.y + Math.sin(arrowAngle + 2.45) * arrowSize);
                    globeContext.lineTo(arrowTip.x + Math.cos(arrowAngle - 2.45) * arrowSize, arrowTip.y + Math.sin(arrowAngle - 2.45) * arrowSize);
                    globeContext.closePath();
                    globeContext.fill();
                    globeContext.shadowBlur = 0;
                }

                const marker = projectGlobePoint(issPosition.latitude, issPosition.longitude, rotation, radius * 1.08, centerX, centerY);
                if (marker.visible) {
                    const pulse = reduceMotion.matches ? 10 : 10 + Math.sin(time * 0.006) * 3;
                    globeContext.strokeStyle = bright;
                    globeContext.lineWidth = 1.5;
                    globeContext.beginPath();
                    globeContext.arc(marker.x, marker.y, pulse, 0, Math.PI * 2);
                    globeContext.stroke();
                    globeContext.fillStyle = bright;
                    globeContext.font = '22px sans-serif';
                    globeContext.textAlign = 'center';
                    globeContext.textBaseline = 'middle';
                    globeContext.fillText('🛰️', marker.x, marker.y);
                    globeContext.font = '600 11px monospace';
                    globeContext.textAlign = 'left';
                    globeContext.fillText(globeStatus.classList.contains('is-live') ? 'ISS LIVE' : 'ISS', marker.x + 18, marker.y - 13);
                }
            }

            if (!reduceMotion.matches && !document.hidden && !document.getElementById('iss-panel').hidden) globeAnimationFrame = requestAnimationFrame(drawGlobe);
        }

        function restartGlobe() {
            cancelAnimationFrame(globeAnimationFrame);
            if (document.getElementById('iss-panel').hidden || document.hidden) return;
            resizeGlobeCanvas();
            drawGlobe();
        }

        window.addEventListener('iss-panel-open', restartGlobe);
        window.addEventListener('iss-panel-close', () => cancelAnimationFrame(globeAnimationFrame));
        restartGlobe();
        window.addEventListener('resize', restartGlobe, { passive: true });
        reduceMotion.addEventListener('change', restartGlobe);
        document.getElementById('toggle-dark-mode')?.addEventListener('click', restartGlobe);

        window.addEventListener('iss-position', event => {
            issPosition = event.detail;
            globeStatus.textContent = `${issPosition.latitude.toFixed(2)}° / ${issPosition.longitude.toFixed(2)}°`;
            globeStatus.classList.add('is-live');
            globeHologram.classList.add('is-tracking');
            restartGlobe();
        });
        window.addEventListener('iss-position-unavailable', restartGlobe);
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) cancelAnimationFrame(globeAnimationFrame);
            else restartGlobe();
        });    </script>
}



