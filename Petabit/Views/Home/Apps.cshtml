@{
    ViewData["Title"] = "Aplikacije za učenje programiranja";
    ViewData["Description"] = "Preporučene aplikacije za učenje programiranja, tehnologije i razvoj digitalnih vještina.";
}
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer


<div class="container content-page resource-page">
    <a class="resource-back" href="/">@Localizer["BackHome"]</a>
    <p class="resource-kicker">@Localizer["ExploreResources"]</p>
    <h1>📱 @Localizer["LearnWithApps"]</h1>
    <p class="resource-intro">@Localizer["PageIntro"]</p>
    <ul class="list-group mt-3 resource-grid">
        <li class="list-group-item">
            <a href="https://getmimo.com/invite/6meni7" target="_blank" rel="noopener noreferrer">Mimo App</a>
        </li>
        <li class="list-group-item">
            <a href="https://sololearn.com" target="_blank" rel="noopener noreferrer">SoloLearn</a>
        </li>
        <!-- More apps to come -->
    </ul>
</div>

