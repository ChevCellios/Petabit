@{
    ViewData["Title"] = "ISS Tracker – Minimalni prikaz";
    ViewData["Description"] = "Lagana verzija ISS trackera koja podatke dohvaća iz Petabit API endpointa.";
    Layout = "_Layout";
}

<h1>🛰️ ISS Tracker – Minimalni prikaz</h1>

<p id="minimal-tracker-description" class="lead">
    Lagana verzija ISS trackera koja trenutačnu lokaciju, brzinu i status postaje dohvaća iz
    Petabit API endpointa <code>/Home/Data</code>.
</p>

<button id="iss-ping-button" class="btn btn-primary" aria-describedby="minimal-tracker-description">🔭 Ping ISS</button>
<audio id="ping-sound" src="/sounds/zvuk.mp3" preload="auto"></audio>

<div id="iss-result" class="mt-3"></div>
<div id="iss-speed" class="mt-1"></div>
<div id="iss-astronauts" class="mt-1"></div>
<div id="astronaut-count" class="mt-1"></div>
<div id="docked-vehicles" class="mt-3"></div>
<div id="iss-source" class="mt-2"></div>

@section Scripts {
    <script src="~/js/iss-tracker.js"></script>
}
