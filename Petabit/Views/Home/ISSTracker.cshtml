@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
    ViewData["Description"] = Localizer["Description"];
    Layout = "_Layout";
}

<h1>🛰️ @Localizer["Heading"]</h1>

<p id="minimal-tracker-description" class="lead">
    @Localizer["Intro"] <code>/Home/Data</code>.
</p>

<button id="iss-ping-button" class="btn btn-primary" aria-describedby="minimal-tracker-description">🔭 @Localizer["PingButton"]</button>
<audio id="ping-sound" src="/sounds/zvuk.mp3" preload="auto"></audio>

<div id="iss-localization" hidden
     data-loading="@Localizer["Loading"]"
     data-location="@(Localizer["Location"].Value)"
     data-speed="@(Localizer["Speed"].Value)"
     data-count="@(Localizer["AstronautCount"].Value)"
     data-crew="@Localizer["Crew"]"
     data-docked="@Localizer["Docked"]"
     data-reference="@(Localizer["Reference"].Value)"
     data-error="@Localizer["Error"]"
     data-usa="@Localizer["CountryUSA"]"
     data-france="@Localizer["CountryFrance"]"
     data-russia="@Localizer["CountryRussia"]"
     data-crewed="@Localizer["CrewedVehicle"]"
     data-cargo="@Localizer["CargoVehicle"]"></div>

<div id="iss-result" class="mt-3" role="status" aria-live="polite"></div>
<div id="iss-speed" class="mt-1"></div>
<div id="iss-astronauts" class="mt-1"></div>
<div id="astronaut-count" class="mt-1"></div>
<div id="docked-vehicles" class="mt-3"></div>
<div id="iss-source" class="mt-2"></div>

@section Scripts {
    <script src="~/js/iss-tracker.js" asp-append-version="true"></script>
}
