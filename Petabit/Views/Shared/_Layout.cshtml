@*<!-- Omogućuje lokalizaciju i dohvat kulture iz zahtjeva-->*@
@using Microsoft.AspNetCore.Localization 
@using System.Text.Encodings.Web
@using System.Text.Json
@* Ubrizgava lokalizator za prikaz lokaliziranih *@
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject IConfiguration Configuration

@{
    var culture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    var cspNonce = Context.Items["CspNonce"]?.ToString();
    var siteName = Configuration["Seo:SiteName"] ?? "Petabit";
    var siteUrl = (Configuration["Seo:SiteUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}").TrimEnd('/');
    var pageTitle = ViewData["Title"]?.ToString() ?? siteName;
    var description = ViewData["Description"]?.ToString() ?? "Petabit je višejezična tehnološka platforma za učenje, digitalne alate i praćenje ISS-a.";
    var canonicalUrl = $"{siteUrl}{Context.Request.PathBase}{Context.Request.Path}";
    var image = $"{siteUrl}/img/petabit-app-preview.png?v=2";
    const string imageAlt = "Petabit aplikacija s prikazom ISS trackera";
    var ogLocale = culture switch { "hr" => "hr_HR", "de" => "de_DE", _ => "en_US" };
    var structuredData = JsonSerializer.Serialize(
        new Dictionary<string, string>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebSite",
            ["name"] = siteName,
            ["url"] = siteUrl,
            ["description"] = description,
            ["inLanguage"] = culture
        },
        new JsonSerializerOptions { Encoder = JavaScriptEncoder.Default });
}

<!DOCTYPE html>
<html lang="@culture">
<head>
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/favicon-96x96.png" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#000000">

    <!-- Primary Meta -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle | @siteName</title>
    <meta name="title" content="@pageTitle" />
    <meta name="description" content="@description" />
    <meta name="keywords" content="Petabit, tech, learning, .NET, ASP.NET Core, AI tools, multilingual" />
    <meta name="author" content="Petabit" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="@image" />
    <meta property="og:image:secure_url" content="@image" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1323" />
    <meta property="og:image:height" content="660" />
    <meta property="og:image:alt" content="@imageAlt" />
    <meta property="og:site_name" content="@siteName" />
    <meta property="og:locale" content="@ogLocale" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@image" />
    <meta name="twitter:image:alt" content="@imageAlt" />

    <script type="application/ld+json" nonce="@cspNonce">@Html.Raw(structuredData)</script>
    <script src="~/js/theme.js" asp-append-version="true"></script>

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/content-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Petabit.styles.css" asp-append-version="true" />


    <style nonce="@cspNonce">
        html {
            min-height: 100%;
            color-scheme: dark;
            background-color: #09131b;
        }

        html[data-theme="light"] {
            color-scheme: light;
            background-color: #9faeb3;
        }

        body {
            min-height: 100vh;
            min-height: 100svh;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        .site-header {
            position: relative;
            height: auto;
        }

        .site-main-shell {
            width: 100%;
            flex: 1 0 auto;
        }

        .navbar.matrix .matrix-nav-row {
            display: flex;
            flex-wrap: nowrap;
            justify-content: flex-start;
            z-index: 2;
        }

        .navbar.matrix .matrix-nav-row .navbar-brand {
            flex: 0 0 auto;
            margin-right: 1rem;
        }

        .navbar.matrix .matrix-nav-links {
            flex: 0 1 auto;
            width: auto;
        }

        main[role="main"] .btn:not(#iss-ping-button) {
            padding: 0.25rem 0.6rem;
            font-size: 0.82rem;
            line-height: 1.25;
        }

        main[role="main"] .btn-home:not(#iss-ping-button) {
            min-width: 150px;
            max-width: 185px;
        }

        .footer-source-links {
            margin-left: 0.45rem;
            font-size: 0.68rem;
            white-space: nowrap;
        }

        .btn-home {
            min-width: 180px;
            max-width: 220px;
            text-align: center;
            white-space: nowrap;
            margin-bottom: 8px;
        }
    </style>

    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/orbital-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-chrome.css" asp-append-version="true" />
</head>
<body class="dark-mode" data-analytics-id="@Configuration["Analytics:MeasurementId"]">
    <script nonce="@cspNonce">
        document.body.classList.toggle('light-mode', document.documentElement.dataset.theme === 'light');
        document.body.classList.toggle('dark-mode', document.documentElement.dataset.theme !== 'light');
    </script>
    <canvas id="page-hologram" aria-hidden="true"></canvas>
    <!-- Header & Navigation -->
    <header class="site-header">
        <nav class="navbar matrix" aria-label="@Localizer["MainNavigation"]">
            <canvas id="matrixCanvas" aria-hidden="true"></canvas>

            <div class="container-fluid position-relative matrix-nav-row">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">◈</span><span>Petabit</span></a>

                <div class="matrix-nav-links">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(Context.Request.Path == "/" || Context.Request.Path == "/Home/Index" ? "page" : null)">@Localizer["Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy" aria-current="@(Context.Request.Path == "/Home/Privacy" ? "page" : null)">@Localizer["Privacy"]</a>
                        </li>
                    </ul>
                </div>
                <div class="matrix-nav-settings">
                    <form asp-controller="Home" asp-action="SetLanguage" method="post">
                        <select id="culture-selector" name="culture" class="form-select" aria-label="@Localizer["LanguageSelector"]">
                            <option value="en" selected="@(culture == "en" ? "selected" : null)">EN</option>
                            <option value="hr" selected="@(culture == "hr" ? "selected" : null)">HR</option>
                            <option value="de" selected="@(culture == "de" ? "selected" : null)">DE</option>
                        </select>
                    </form>
                    <button id="toggle-dark-mode" class="mode-toggle" type="button" aria-pressed="true" aria-label="@Localizer["ChangeTheme"]" title="@Localizer["ChangeTheme"]"><span aria-hidden="true">🌓</span><span class="theme-toggle-label">@Localizer["ChangeTheme"]</span></button>
                </div>
            </div>
        </nav>
    </header>

    <section id="analytics-consent" class="container analytics-consent-banner" role="region" aria-labelledby="analytics-consent-title" tabindex="-1" hidden>
        <div class="consent-copy">
            <h2 id="analytics-consent-title">@Localizer["AnalyticsSettings"]</h2>
            <p>@Localizer["AnalyticsDescription"]</p>
            <p id="analytics-storage-status" class="consent-storage-status" role="status" hidden>@Localizer["AnalyticsStorageUnavailable"]</p>
        </div>
        <div class="consent-actions">
            <button id="analytics-accept" type="button" class="consent-choice">@Localizer["Accept"]</button>
            <button id="analytics-reject" type="button" class="consent-choice">@Localizer["Reject"]</button>
            <a asp-controller="Home" asp-action="Privacy">@Localizer["LearnMore"]</a>
        </div>
    </section>
    <script nonce="@cspNonce">
        // Set the in-flow banner before parsing main content to avoid a late layout shift.
        // Analytics loading remains gated by explicit consent in site.js.
        (() => {
            if (!document.body.dataset.analyticsId) return;
            let preference;
            try { preference = localStorage.getItem('petabit-analytics-consent'); } catch { }
            document.getElementById('analytics-consent').hidden = preference === 'accepted' || preference === 'rejected';
        })();
    </script>

    <!-- Glavni sadržaj -->
    <div class="container site-main-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container footer-row">
            <p class="footer-brand">&copy; @DateTime.UtcNow.Year <strong>Petabit</strong></p>
            <nav class="footer-nav" aria-label="@Localizer["FooterNavigation"]">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
                @if (!string.IsNullOrWhiteSpace(Configuration["Analytics:MeasurementId"]))
                {
                    <button type="button" class="footer-consent-button" data-manage-analytics>@Localizer["AnalyticsSettings"]</button>
                }
            </nav>
            <nav class="footer-source-links" aria-label="@Localizer["ExternalSources"]">
                <a href="https://www.nasa.gov/" target="_blank" rel="noopener noreferrer">NASA <span aria-hidden="true">↗</span></a>
                <a href="https://wheretheiss.at/" target="_blank" rel="noopener noreferrer">Open API <span aria-hidden="true">↗</span></a>
            </nav>
        </div>
    </footer>

    <!-- JS biblioteke -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/page-hologram.js" asp-append-version="true"></script>
    <script src="~/js/matrix-header.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

