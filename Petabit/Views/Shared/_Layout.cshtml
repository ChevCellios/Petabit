@*<!-- Omogućuje lokalizaciju i dohvat kulture iz zahtjeva-->*@
@using Microsoft.AspNetCore.Localization 
@using System.Text.Encodings.Web
@using System.Text.Json
@* Ubrizgava lokalizator za prikaz lokaliziranih *@
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject IConfiguration Configuration

@{
    var culture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.TwoLetterISOLanguageName ?? "en";
    var cspNonce = Context.Items["CspNonce"]?.ToString();
    var siteName = Configuration["Seo:SiteName"] ?? "Petabit";
    var siteUrl = (Configuration["Seo:SiteUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}").TrimEnd('/');
    var pageTitle = ViewData["Title"]?.ToString() ?? siteName;
    var description = ViewData["Description"]?.ToString() ?? "Petabit je višejezična tehnološka platforma za učenje, digitalne alate i praćenje ISS-a.";
    var canonicalUrl = $"{siteUrl}{Context.Request.PathBase}{Context.Request.Path}";
    var image = $"{siteUrl}/img/petabit-app-preview.png?v=2";
    const string imageAlt = "Petabit aplikacija s prikazom ISS trackera";
    var ogLocale = culture switch { "hr" => "hr_HR", "de" => "de_DE", _ => "en_US" };
    var structuredData = JsonSerializer.Serialize(
        new Dictionary<string, string>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebSite",
            ["name"] = siteName,
            ["url"] = siteUrl,
            ["description"] = description,
            ["inLanguage"] = culture
        },
        new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
}

<!DOCTYPE html>
<html lang="@culture">
<head>
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/favicon-96x96.png" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#000000">

    <!-- Primary Meta -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle | @siteName</title>
    <meta name="title" content="@pageTitle" />
    <meta name="description" content="@description" />
    <meta name="keywords" content="Petabit, tech, learning, .NET, ASP.NET Core, AI tools, multilingual" />
    <meta name="author" content="Petabit" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="@image" />
    <meta property="og:image:secure_url" content="@image" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1323" />
    <meta property="og:image:height" content="660" />
    <meta property="og:image:alt" content="@imageAlt" />
    <meta property="og:site_name" content="@siteName" />
    <meta property="og:locale" content="@ogLocale" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@image" />
    <meta name="twitter:image:alt" content="@imageAlt" />

    <script type="application/ld+json" nonce="@cspNonce">@Html.Raw(structuredData)</script>

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/content-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Petabit.styles.css" asp-append-version="true" />

    <style nonce="@cspNonce">
        html {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            min-height: 100svh;
            margin: 0;
            display: flex;
            flex-direction: column;
        }

        .site-header {
            position: relative;
            height: auto;
        }

        .site-main-shell {
            width: 100%;
            flex: 1 0 auto;
        }

        .navbar.matrix .matrix-nav-row {
            display: flex;
            flex-wrap: nowrap;
            justify-content: flex-start;
            z-index: 2;
        }

        .navbar.matrix .matrix-nav-row .navbar-brand {
            flex: 0 0 auto;
            margin-right: 1rem;
        }

        .navbar.matrix .matrix-nav-links {
            flex: 0 1 auto;
            width: auto;
        }

        main[role="main"] .btn:not(#iss-ping-button) {
            padding: 0.25rem 0.6rem;
            font-size: 0.82rem;
            line-height: 1.25;
        }

        main[role="main"] .btn-home:not(#iss-ping-button) {
            min-width: 150px;
            max-width: 185px;
        }

        .footer-source-links {
            margin-left: 0.45rem;
            font-size: 0.68rem;
            white-space: nowrap;
        }

        .btn-home {
            min-width: 180px;
            max-width: 220px;
            text-align: center;
            white-space: nowrap;
            margin-bottom: 8px;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="dark-mode" data-analytics-id="@Configuration["Analytics:MeasurementId"]">
    <!-- Header & Navigation -->
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark matrix">
            <canvas id="matrixCanvas"></canvas>

            <div class="container-fluid position-relative matrix-nav-row">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Petabit</a>

                <div class="navbar-collapse d-flex matrix-nav-links">
                    <ul class="navbar-nav flex-row align-items-center gap-2">
                        <li class="nav-item">
                            <form asp-controller="Home" asp-action="SetLanguage" method="post" class="d-inline">
                                <select id="culture-selector" name="culture" class="form-select form-select-sm w-auto d-inline" aria-label="@Localizer["LanguageSelector"]">
                                    <option value="en" selected="@(culture == "en" ? "selected" : null)">EN</option>
                                    <option value="hr" selected="@(culture == "hr" ? "selected" : null)">HR</option>
                                    <option value="de" selected="@(culture == "de" ? "selected" : null)">DE</option>
                                </select>
                            </form>

                            
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <button id="toggle-dark-mode" class="btn border-0" type="button" aria-label="@Localizer["ChangeTheme"]" title="@Localizer["ChangeTheme"]">🌓</button>
    </header>

    <!-- Glavni sadržaj -->
    <div class="container site-main-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer border-top">
        <div class="container">
            &copy; @DateTime.UtcNow.Year - Petabit - <a asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
            <span class="footer-source-links" aria-label="@Localizer["ExternalSources"]">
                · <a href="https://www.nasa.gov/" target="_blank" rel="noopener noreferrer">NASA</a>
                · <a href="https://wheretheiss.at/" target="_blank" rel="noopener noreferrer">Open API</a>
            </span>
        </div>
    </footer>

    <section id="analytics-consent" class="analytics-consent-compact border rounded bg-dark text-light" role="dialog" aria-label="@Localizer["AnalyticsSettings"]" aria-live="polite" hidden>
        <p class="mb-1">@Localizer["AnalyticsDescription"]</p>
        <div class="d-flex gap-1 align-items-center flex-wrap">
            <button id="analytics-accept" type="button" class="btn btn-success btn-sm">@Localizer["Accept"]</button>
            <button id="analytics-reject" type="button" class="btn btn-outline-light btn-sm">@Localizer["Reject"]</button>
            <a asp-controller="Home" asp-action="Privacy">@Localizer["LearnMore"]</a>
        </div>
    </section>

    <!-- JS biblioteke -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Matrix animacija -->
    <script nonce="@cspNonce">
        const canvas = document.getElementById("matrixCanvas");
        const ctx = canvas.getContext("2d");

        function resizeCanvas() {
            const navbar = document.querySelector("nav.navbar");
            canvas.width = navbar.offsetWidth;
            canvas.height = navbar.offsetHeight;
        }

        let columns, drops;
        const fontSize = 1;
        const matrixChars = "アァイィウエカガキギクグケゲコゴサザシジスズタダチッヅテデトドナニヌネノハバパヒビピフブプヘベペホボポマミムメモヤユヨラリルレロワンABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        const letters = matrixChars.split("");

        function setupMatrix() {
            columns = Math.floor(canvas.width / fontSize);
            drops = Array.from({ length: columns }).fill(1);
        }

        function drawMatrix() {
            ctx.fillStyle = "rgba(0, 0, 0, 0.05)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "#00ff00";
            ctx.font = fontSize + "px monospace";

            for (let i = 0; i < drops.length; i++) {
                const text = letters[Math.floor(Math.random() * letters.length)];
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height || Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            }
        }

        resizeCanvas();
        setupMatrix();
        setInterval(drawMatrix, 33);
        window.addEventListener("resize", () => {
            resizeCanvas();
            setupMatrix();
        });
    </script>

    <!-- Dark/Light Mode Toggle -->
    <script nonce="@cspNonce">
        const body = document.body;
        const toggle = document.getElementById('toggle-dark-mode');

        // Postavi temu na temelju spremljene vrijednosti u localStorage
        if (localStorage.getItem("theme") === "light") {
            body.classList.remove("dark-mode");
            body.classList.add("light-mode");
        } else {
            body.classList.add("dark-mode");
            body.classList.remove("light-mode");
        }

        // Kad korisnik klikne na prekidač, promijeni temu i spremi novu postavku
        toggle.addEventListener('click', () => {
            if (body.classList.contains("dark-mode")) {
                body.classList.replace("dark-mode", "light-mode");
                localStorage.setItem("theme", "light");
            } else {
                body.classList.replace("light-mode", "dark-mode");
                localStorage.setItem("theme", "dark");
            }
        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

